Bundle-Name: oss-forms
Bundle-SymbolicName: nl.deltares.forms
Bundle-Version: 2.0.0
Export-Package: nl.deltares.forms.portlet
Import-Package:\
	nl.deltares.portal.utils.*,\
	nl.deltares.portal.constants.*,\
	nl.deltares.tasks.*,\
	nl.deltares.common.*,\
	*
Provide-Capability:\
	liferay.language.resources;\
		resource.bundle.base.name="content.Language"
Web-ContextPath: /dsd-registration
-metatype: *
-sources: true